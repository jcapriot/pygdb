# All real-world sample files are intentionally NOT committed to git --
# we may not have redistribution rights for them. Provenance (exact
# source URL/DOI/portal, size) for every sample is recorded in
# docs/provenance/notes.md and docs/provenance/log.md so they can be
# re-downloaded independently.
samples*

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.venv/

# MkDocs build output
site/

# Rust
rust/target/
rust/dist/
pygdb/*.pyd
pygdb/*.so
pygdb/*.pdb

# cibuildwheel local output
wheelhouse/
